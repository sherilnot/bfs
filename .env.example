# Copy to .env and adjust. Never commit the real .env.

PORT=3000
HOST=127.0.0.1

# Required to switch on the admin read endpoints. Without it they return 503,
# so enquiry data is never readable by accident.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Optional: move the SQLite file elsewhere (default ./data/enquiries.db)
# DB_PATH=./data/enquiries.db

# Set when running behind a reverse proxy so rate limiting sees real client IPs.
# TRUST_PROXY=1

# Production environment template.
# Copy to .env (or set these in your platform's dashboard) and fill in values.
# NEVER commit the filled-in file — .env is gitignored.

# Bind on all interfaces inside a container / VM.
HOST=0.0.0.0
PORT=3000

# Keep the SQLite file on a persistent disk / mounted volume.
DB_PATH=/app/data/enquiries.db

# REQUIRED to read submitted enquiries. Without it the admin API stays disabled
# (fails closed). Generate a strong token with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Set to 1 when running behind a TLS-terminating reverse proxy so the rate
# limiter sees real client IPs instead of the proxy's.
TRUST_PROXY=1

# Optional tuning (defaults shown).
# SUBMIT_RATE_MAX=5
# SUBMIT_RATE_WINDOW_MS=600000
